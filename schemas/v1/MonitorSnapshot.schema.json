{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "value",
        "score"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "calibration_id": {
          "title": "Calibration Id",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "stable_frames": {
          "default": 1,
          "minimum": 1,
          "title": "Stable Frames",
          "type": "integer"
        }
      },
      "required": [
        "score",
        "calibration_id"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "EventAmount": {
      "additionalProperties": false,
      "properties": {
        "to_bb": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Bb"
        },
        "added_bb": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Added Bb"
        }
      },
      "title": "EventAmount",
      "type": "object"
    },
    "EventCategory": {
      "enum": [
        "betting_action",
        "lifecycle",
        "forced_wager",
        "dealing",
        "settlement"
      ],
      "title": "EventCategory",
      "type": "string"
    },
    "HandEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "hand_id": {
          "format": "uuid",
          "title": "Hand Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/EventCategory"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "hand_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/HandMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actor_seat": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Seat"
        },
        "street": {
          "$ref": "#/$defs/Street",
          "default": "none"
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventAmount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cards": {
          "items": {
            "type": "string"
          },
          "title": "Cards",
          "type": "array"
        },
        "dealer_seat": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dealer Seat"
        },
        "winner_seat": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Winner Seat"
        },
        "pot_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pot Index"
        },
        "input_observations": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Input Observations",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "hand_id",
        "sequence",
        "category",
        "type",
        "confidence"
      ],
      "title": "HandEvent",
      "type": "object"
    },
    "HandMode": {
      "enum": [
        "standard_nlh",
        "single_board_bomb_pot"
      ],
      "title": "HandMode",
      "type": "string"
    },
    "HandState": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state_id": {
          "format": "uuid",
          "title": "State Id",
          "type": "string"
        },
        "hand_id": {
          "format": "uuid",
          "title": "Hand Id",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "last_event_sequence": {
          "default": 0,
          "minimum": 0,
          "title": "Last Event Sequence",
          "type": "integer"
        },
        "config_version": {
          "title": "Config Version",
          "type": "string"
        },
        "table_size": {
          "enum": [
            6,
            9
          ],
          "title": "Table Size",
          "type": "integer"
        },
        "hand_mode": {
          "$ref": "#/$defs/HandMode",
          "default": "standard_nlh"
        },
        "table_status": {
          "$ref": "#/$defs/TableStatus",
          "default": "waiting_for_hand"
        },
        "street": {
          "$ref": "#/$defs/Street",
          "default": "none"
        },
        "dealer_seat": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dealer Seat"
        },
        "hero_seat": {
          "maximum": 8,
          "minimum": 0,
          "title": "Hero Seat",
          "type": "integer"
        },
        "hero_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hero_cards": {
          "items": {
            "type": "string"
          },
          "title": "Hero Cards",
          "type": "array"
        },
        "board": {
          "items": {
            "type": "string"
          },
          "title": "Board",
          "type": "array"
        },
        "seats": {
          "items": {
            "$ref": "#/$defs/SeatState"
          },
          "title": "Seats",
          "type": "array"
        },
        "pot_main_bb": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Pot Main Bb"
        },
        "pot_layers": {
          "items": {
            "$ref": "#/$defs/PotLayer"
          },
          "title": "Pot Layers",
          "type": "array"
        },
        "current_bet_bb": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Current Bet Bb"
        },
        "minimum_raise_increment_bb": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Minimum Raise Increment Bb"
        },
        "last_aggressor_seat": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Aggressor Seat"
        },
        "next_to_act_seat": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next To Act Seat"
        },
        "acted_seats": {
          "items": {
            "type": "integer"
          },
          "title": "Acted Seats",
          "type": "array"
        },
        "raise_locked_seats": {
          "items": {
            "type": "integer"
          },
          "title": "Raise Locked Seats",
          "type": "array"
        },
        "initial_total_chips_bb": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Initial Total Chips Bb"
        },
        "available_actions": {
          "items": {
            "type": "string"
          },
          "title": "Available Actions",
          "type": "array"
        },
        "event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "validation": {
          "$ref": "#/$defs/ValidationState"
        }
      },
      "required": [
        "hand_id",
        "config_version",
        "table_size",
        "hero_seat",
        "seats"
      ],
      "title": "HandState",
      "type": "object"
    },
    "MonitorHealth": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "degraded",
            "stopped"
          ],
          "title": "Status",
          "type": "string"
        },
        "mode": {
          "default": "observe",
          "enum": [
            "observe",
            "analyze",
            "recommend"
          ],
          "title": "Mode",
          "type": "string"
        },
        "capture_active": {
          "default": false,
          "title": "Capture Active",
          "type": "boolean"
        },
        "controller_enabled": {
          "const": false,
          "default": false,
          "title": "Controller Enabled",
          "type": "boolean"
        },
        "strategy_status": {
          "default": "unavailable",
          "enum": [
            "exact",
            "abstracted",
            "unavailable"
          ],
          "title": "Strategy Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "MonitorHealth",
      "type": "object"
    },
    "MonitorMetrics": {
      "additionalProperties": false,
      "properties": {
        "frames_processed": {
          "default": 0,
          "minimum": 0,
          "title": "Frames Processed",
          "type": "integer"
        },
        "state_revision": {
          "default": 0,
          "minimum": 0,
          "title": "State Revision",
          "type": "integer"
        },
        "event_count": {
          "default": 0,
          "minimum": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "stream_sequence": {
          "default": 0,
          "minimum": 0,
          "title": "Stream Sequence",
          "type": "integer"
        },
        "dropped_deliveries": {
          "default": 0,
          "minimum": 0,
          "title": "Dropped Deliveries",
          "type": "integer"
        },
        "processing_latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Processing Latency Ms",
          "type": "number"
        }
      },
      "title": "MonitorMetrics",
      "type": "object"
    },
    "ParticipationStatus": {
      "enum": [
        "empty",
        "seated",
        "active",
        "folded",
        "all_in",
        "sitting_out",
        "on_break",
        "disconnected"
      ],
      "title": "ParticipationStatus",
      "type": "string"
    },
    "Position": {
      "enum": [
        "UTG",
        "UTG+1",
        "MP",
        "LJ",
        "HJ",
        "CO",
        "BTN",
        "SB",
        "BB"
      ],
      "title": "Position",
      "type": "string"
    },
    "PotLayer": {
      "additionalProperties": false,
      "properties": {
        "pot_index": {
          "minimum": 0,
          "title": "Pot Index",
          "type": "integer"
        },
        "amount_bb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount Bb"
        },
        "remaining_bb": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Remaining Bb"
        },
        "cap_per_player_bb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Cap Per Player Bb"
        },
        "contributing_seats": {
          "items": {
            "type": "integer"
          },
          "title": "Contributing Seats",
          "type": "array"
        },
        "eligible_seats": {
          "items": {
            "type": "integer"
          },
          "title": "Eligible Seats",
          "type": "array"
        }
      },
      "required": [
        "pot_index",
        "amount_bb",
        "remaining_bb",
        "cap_per_player_bb",
        "contributing_seats",
        "eligible_seats"
      ],
      "title": "PotLayer",
      "type": "object"
    },
    "ReplayProgress": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "default": false,
          "title": "Active",
          "type": "boolean"
        },
        "index": {
          "default": 0,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "total": {
          "default": 0,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "interval_ms": {
          "default": 250,
          "maximum": 5000,
          "minimum": 25,
          "title": "Interval Ms",
          "type": "integer"
        }
      },
      "title": "ReplayProgress",
      "type": "object"
    },
    "SeatState": {
      "additionalProperties": false,
      "properties": {
        "seat": {
          "maximum": 8,
          "minimum": 0,
          "title": "Seat",
          "type": "integer"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "participation": {
          "$ref": "#/$defs/ParticipationStatus"
        },
        "starting_stack_bb": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Starting Stack Bb"
        },
        "stack_bb": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Stack Bb"
        },
        "committed_by_street_bb": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "propertyNames": {
            "$ref": "#/$defs/Street"
          },
          "title": "Committed By Street Bb",
          "type": "object"
        },
        "cards": {
          "items": {
            "type": "string"
          },
          "title": "Cards",
          "type": "array"
        }
      },
      "required": [
        "seat",
        "participation",
        "starting_stack_bb",
        "stack_bb"
      ],
      "title": "SeatState",
      "type": "object"
    },
    "Street": {
      "enum": [
        "none",
        "preflop",
        "flop",
        "turn",
        "river",
        "showdown"
      ],
      "title": "Street",
      "type": "string"
    },
    "TableStatus": {
      "enum": [
        "unavailable",
        "ready",
        "waiting_for_hand",
        "in_hand",
        "hand_complete"
      ],
      "title": "TableStatus",
      "type": "string"
    },
    "ValidationState": {
      "additionalProperties": false,
      "properties": {
        "legal": {
          "default": true,
          "title": "Legal",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "ValidationState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "default": 0,
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "table_size": {
      "enum": [
        6,
        9
      ],
      "title": "Table Size",
      "type": "integer"
    },
    "source_mode": {
      "enum": [
        "synthetic_replay",
        "recorded_replay",
        "authorized_live"
      ],
      "title": "Source Mode",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/HandState"
    },
    "action_history": {
      "items": {
        "$ref": "#/$defs/HandEvent"
      },
      "title": "Action History",
      "type": "array"
    },
    "health": {
      "$ref": "#/$defs/MonitorHealth"
    },
    "metrics": {
      "$ref": "#/$defs/MonitorMetrics"
    },
    "replay": {
      "$ref": "#/$defs/ReplayProgress"
    },
    "poker_math": {
      "additionalProperties": true,
      "title": "Poker Math",
      "type": "object"
    },
    "strategy": {
      "additionalProperties": true,
      "title": "Strategy",
      "type": "object"
    },
    "exploit": {
      "additionalProperties": true,
      "title": "Exploit",
      "type": "object"
    },
    "audit": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Audit",
      "type": "array"
    }
  },
  "required": [
    "generated_at",
    "table_size",
    "source_mode",
    "state",
    "action_history",
    "health",
    "metrics",
    "replay",
    "poker_math",
    "strategy",
    "exploit"
  ],
  "title": "MonitorSnapshot",
  "type": "object"
}
