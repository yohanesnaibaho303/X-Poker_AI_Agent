{
  "$defs": {
    "OperatingMode": {
      "enum": [
        "observe",
        "analyze",
        "recommend",
        "armed_test_control"
      ],
      "title": "OperatingMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/OperatingMode",
      "default": "observe"
    },
    "host": {
      "default": "127.0.0.1",
      "title": "Host",
      "type": "string"
    },
    "port": {
      "default": 8765,
      "maximum": 65535,
      "minimum": 1,
      "title": "Port",
      "type": "integer"
    },
    "capture_fps_min": {
      "default": 5,
      "maximum": 60,
      "minimum": 1,
      "title": "Capture Fps Min",
      "type": "integer"
    },
    "capture_fps_max": {
      "default": 15,
      "maximum": 60,
      "minimum": 1,
      "title": "Capture Fps Max",
      "type": "integer"
    },
    "controller_enabled": {
      "const": false,
      "default": false,
      "title": "Controller Enabled",
      "type": "boolean"
    },
    "evidence_retention": {
      "const": "failures_and_actions",
      "default": "failures_and_actions",
      "title": "Evidence Retention",
      "type": "string"
    }
  },
  "title": "RuntimeConfig",
  "type": "object"
}
