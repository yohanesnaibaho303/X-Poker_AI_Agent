{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "value",
        "score"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "calibration_id": {
          "title": "Calibration Id",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "stable_frames": {
          "default": 1,
          "minimum": 1,
          "title": "Stable Frames",
          "type": "integer"
        }
      },
      "required": [
        "score",
        "calibration_id"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "EventAmount": {
      "additionalProperties": false,
      "properties": {
        "to_chips": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Chips"
        },
        "added_chips": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Added Chips"
        }
      },
      "title": "EventAmount",
      "type": "object"
    },
    "EventCategory": {
      "enum": [
        "betting_action",
        "lifecycle",
        "forced_wager",
        "dealing",
        "settlement"
      ],
      "title": "EventCategory",
      "type": "string"
    },
    "HandMode": {
      "enum": [
        "standard_nlh",
        "single_board_bomb_pot"
      ],
      "title": "HandMode",
      "type": "string"
    },
    "Street": {
      "enum": [
        "none",
        "preflop",
        "flop",
        "turn",
        "river",
        "showdown"
      ],
      "title": "Street",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "hand_id": {
      "format": "uuid",
      "title": "Hand Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "category": {
      "$ref": "#/$defs/EventCategory"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "hand_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/HandMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "actor_seat": {
      "anyOf": [
        {
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor Seat"
    },
    "street": {
      "$ref": "#/$defs/Street",
      "default": "none"
    },
    "amount": {
      "anyOf": [
        {
          "$ref": "#/$defs/EventAmount"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cards": {
      "items": {
        "type": "string"
      },
      "title": "Cards",
      "type": "array"
    },
    "dealer_seat": {
      "anyOf": [
        {
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dealer Seat"
    },
    "winner_seat": {
      "anyOf": [
        {
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Winner Seat"
    },
    "pot_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pot Index"
    },
    "input_observations": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Input Observations",
      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "hand_id",
    "sequence",
    "category",
    "type",
    "confidence"
  ],
  "title": "HandEvent",
  "type": "object"
}
