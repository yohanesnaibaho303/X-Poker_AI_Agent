{
  "$defs": {
    "ReconstructionMetrics": {
      "additionalProperties": false,
      "properties": {
        "total": {
          "minimum": 1,
          "title": "Total",
          "type": "integer"
        },
        "supported_total": {
          "minimum": 0,
          "title": "Supported Total",
          "type": "integer"
        },
        "exact_supported": {
          "minimum": 0,
          "title": "Exact Supported",
          "type": "integer"
        },
        "unsupported_total": {
          "minimum": 0,
          "title": "Unsupported Total",
          "type": "integer"
        },
        "safely_stopped_unsupported": {
          "minimum": 0,
          "title": "Safely Stopped Unsupported",
          "type": "integer"
        },
        "exact_accuracy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact Accuracy"
        },
        "unsupported_safe_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Safe Rate"
        },
        "p95_latency_ms": {
          "minimum": 0,
          "title": "P95 Latency Ms",
          "type": "number"
        }
      },
      "required": [
        "total",
        "supported_total",
        "exact_supported",
        "unsupported_total",
        "safely_stopped_unsupported",
        "p95_latency_ms"
      ],
      "title": "ReconstructionMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "reducer_version": {
      "title": "Reducer Version",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_role": {
      "enum": [
        "regression",
        "holdout"
      ],
      "title": "Dataset Role",
      "type": "string"
    },
    "dataset_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Dataset Sha256",
      "type": "string"
    },
    "target_accuracy": {
      "default": 0.98,
      "maximum": 1,
      "minimum": 0,
      "title": "Target Accuracy",
      "type": "number"
    },
    "metrics": {
      "$ref": "#/$defs/ReconstructionMetrics"
    },
    "promotion_eligible": {
      "title": "Promotion Eligible",
      "type": "boolean"
    },
    "gate_passed": {
      "title": "Gate Passed",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "reducer_version",
    "dataset_id",
    "dataset_role",
    "dataset_sha256",
    "metrics",
    "promotion_eligible",
    "gate_passed",
    "limitations"
  ],
  "title": "ReconstructionEvaluationReport",
  "type": "object"
}
