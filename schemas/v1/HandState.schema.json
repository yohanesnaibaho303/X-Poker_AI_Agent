{
  "$defs": {
    "HandMode": {
      "enum": [
        "standard_nlh",
        "single_board_bomb_pot"
      ],
      "title": "HandMode",
      "type": "string"
    },
    "ParticipationStatus": {
      "enum": [
        "empty",
        "seated",
        "active",
        "folded",
        "all_in",
        "sitting_out",
        "on_break",
        "disconnected"
      ],
      "title": "ParticipationStatus",
      "type": "string"
    },
    "Position": {
      "enum": [
        "UTG",
        "UTG+1",
        "UTG+2",
        "LJ",
        "HJ",
        "CO",
        "BTN",
        "SB",
        "BB"
      ],
      "title": "Position",
      "type": "string"
    },
    "PotLayer": {
      "additionalProperties": false,
      "properties": {
        "pot_index": {
          "minimum": 0,
          "title": "Pot Index",
          "type": "integer"
        },
        "amount_chips": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount Chips"
        },
        "remaining_chips": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Remaining Chips"
        },
        "cap_per_player_chips": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Cap Per Player Chips"
        },
        "contributing_seats": {
          "items": {
            "type": "integer"
          },
          "title": "Contributing Seats",
          "type": "array"
        },
        "eligible_seats": {
          "items": {
            "type": "integer"
          },
          "title": "Eligible Seats",
          "type": "array"
        }
      },
      "required": [
        "pot_index",
        "amount_chips",
        "remaining_chips",
        "cap_per_player_chips",
        "contributing_seats",
        "eligible_seats"
      ],
      "title": "PotLayer",
      "type": "object"
    },
    "SeatState": {
      "additionalProperties": false,
      "properties": {
        "seat": {
          "maximum": 8,
          "minimum": 0,
          "title": "Seat",
          "type": "integer"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "participation": {
          "$ref": "#/$defs/ParticipationStatus"
        },
        "starting_stack_chips": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Starting Stack Chips"
        },
        "stack_chips": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Stack Chips"
        },
        "committed_by_street_chips": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "propertyNames": {
            "$ref": "#/$defs/Street"
          },
          "title": "Committed By Street Chips",
          "type": "object"
        },
        "cards": {
          "items": {
            "type": "string"
          },
          "title": "Cards",
          "type": "array"
        }
      },
      "required": [
        "seat",
        "participation",
        "starting_stack_chips",
        "stack_chips"
      ],
      "title": "SeatState",
      "type": "object"
    },
    "Street": {
      "enum": [
        "none",
        "preflop",
        "flop",
        "turn",
        "river",
        "showdown"
      ],
      "title": "Street",
      "type": "string"
    },
    "TableStatus": {
      "enum": [
        "unavailable",
        "ready",
        "waiting_for_hand",
        "in_hand",
        "hand_complete"
      ],
      "title": "TableStatus",
      "type": "string"
    },
    "ValidationState": {
      "additionalProperties": false,
      "properties": {
        "legal": {
          "default": true,
          "title": "Legal",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "ValidationState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_id": {
      "format": "uuid",
      "title": "State Id",
      "type": "string"
    },
    "hand_id": {
      "format": "uuid",
      "title": "Hand Id",
      "type": "string"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "last_event_sequence": {
      "default": 0,
      "minimum": 0,
      "title": "Last Event Sequence",
      "type": "integer"
    },
    "config_version": {
      "title": "Config Version",
      "type": "string"
    },
    "table_size": {
      "const": 9,
      "title": "Table Size",
      "type": "integer"
    },
    "hand_mode": {
      "$ref": "#/$defs/HandMode",
      "default": "standard_nlh"
    },
    "table_status": {
      "$ref": "#/$defs/TableStatus",
      "default": "waiting_for_hand"
    },
    "street": {
      "$ref": "#/$defs/Street",
      "default": "none"
    },
    "dealer_seat": {
      "anyOf": [
        {
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dealer Seat"
    },
    "hero_seat": {
      "maximum": 8,
      "minimum": 0,
      "title": "Hero Seat",
      "type": "integer"
    },
    "hero_position": {
      "anyOf": [
        {
          "$ref": "#/$defs/Position"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "hero_cards": {
      "items": {
        "type": "string"
      },
      "title": "Hero Cards",
      "type": "array"
    },
    "board": {
      "items": {
        "type": "string"
      },
      "title": "Board",
      "type": "array"
    },
    "seats": {
      "items": {
        "$ref": "#/$defs/SeatState"
      },
      "title": "Seats",
      "type": "array"
    },
    "pot_main_chips": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Pot Main Chips"
    },
    "pot_layers": {
      "items": {
        "$ref": "#/$defs/PotLayer"
      },
      "title": "Pot Layers",
      "type": "array"
    },
    "current_bet_chips": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Current Bet Chips"
    },
    "minimum_raise_increment_chips": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Minimum Raise Increment Chips"
    },
    "last_aggressor_seat": {
      "anyOf": [
        {
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Aggressor Seat"
    },
    "next_to_act_seat": {
      "anyOf": [
        {
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next To Act Seat"
    },
    "acted_seats": {
      "items": {
        "type": "integer"
      },
      "title": "Acted Seats",
      "type": "array"
    },
    "raise_locked_seats": {
      "items": {
        "type": "integer"
      },
      "title": "Raise Locked Seats",
      "type": "array"
    },
    "initial_total_chips": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Initial Total Chips"
    },
    "available_actions": {
      "items": {
        "type": "string"
      },
      "title": "Available Actions",
      "type": "array"
    },
    "event_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Event Ids",
      "type": "array"
    },
    "validation": {
      "$ref": "#/$defs/ValidationState"
    }
  },
  "required": [
    "hand_id",
    "config_version",
    "table_size",
    "hero_seat",
    "seats"
  ],
  "title": "HandState",
  "type": "object"
}
