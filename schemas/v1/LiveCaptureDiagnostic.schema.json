{
  "$defs": {
    "SeatOccupancyObservation": {
      "additionalProperties": false,
      "properties": {
        "seat": {
          "maximum": 8,
          "minimum": 0,
          "title": "Seat",
          "type": "integer"
        },
        "status": {
          "enum": [
            "occupied",
            "empty",
            "ambiguous"
          ],
          "title": "Status",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "dark_panel_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Dark Panel Fraction",
          "type": "number"
        },
        "plus_horizontal_pixels": {
          "minimum": 0,
          "title": "Plus Horizontal Pixels",
          "type": "integer"
        },
        "plus_vertical_pixels": {
          "minimum": 0,
          "title": "Plus Vertical Pixels",
          "type": "integer"
        }
      },
      "required": [
        "seat",
        "status",
        "confidence",
        "dark_panel_fraction",
        "plus_horizontal_pixels",
        "plus_vertical_pixels"
      ],
      "title": "SeatOccupancyObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "frame_sequence": {
      "minimum": 0,
      "title": "Frame Sequence",
      "type": "integer"
    },
    "content_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Content Sha256",
      "type": "string"
    },
    "layout_id": {
      "title": "Layout Id",
      "type": "string"
    },
    "table_size": {
      "enum": [
        6,
        9
      ],
      "title": "Table Size",
      "type": "integer"
    },
    "frame_width": {
      "exclusiveMinimum": 0,
      "title": "Frame Width",
      "type": "integer"
    },
    "frame_height": {
      "exclusiveMinimum": 0,
      "title": "Frame Height",
      "type": "integer"
    },
    "target_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Target Fingerprint",
      "type": "string"
    },
    "capture_latency_ms": {
      "minimum": 0.0,
      "title": "Capture Latency Ms",
      "type": "number"
    },
    "ocr_latency_ms": {
      "minimum": 0.0,
      "title": "Ocr Latency Ms",
      "type": "number"
    },
    "visual_role_confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Visual Role Confidence",
      "type": "number"
    },
    "current_hand_supported": {
      "title": "Current Hand Supported",
      "type": "boolean"
    },
    "current_hand_mode": {
      "enum": [
        "standard_nlh",
        "single_board_bomb_pot",
        "ambiguous"
      ],
      "title": "Current Hand Mode",
      "type": "string"
    },
    "standard_nlh_supported": {
      "title": "Standard Nlh Supported",
      "type": "boolean"
    },
    "single_board_bomb_pot_supported": {
      "title": "Single Board Bomb Pot Supported",
      "type": "boolean"
    },
    "special_rule": {
      "anyOf": [
        {
          "const": "bomb_pot",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Special Rule"
    },
    "bomb_pot_state": {
      "enum": [
        "none",
        "scheduled",
        "active",
        "ambiguous"
      ],
      "title": "Bomb Pot State",
      "type": "string"
    },
    "hands_until_bomb": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hands Until Bomb"
    },
    "bomb_pot_interval_hands": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bomb Pot Interval Hands"
    },
    "rule_confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Rule Confidence",
      "type": "number"
    },
    "mode_reason": {
      "title": "Mode Reason",
      "type": "string"
    },
    "matched_signals": {
      "items": {
        "type": "string"
      },
      "title": "Matched Signals",
      "type": "array"
    },
    "rule_text": {
      "title": "Rule Text",
      "type": "string"
    },
    "pot_text": {
      "title": "Pot Text",
      "type": "string"
    },
    "board_rows": {
      "minimum": 0,
      "title": "Board Rows",
      "type": "integer"
    },
    "board_card_slots": {
      "minimum": 0,
      "title": "Board Card Slots",
      "type": "integer"
    },
    "board_geometry_supported": {
      "title": "Board Geometry Supported",
      "type": "boolean"
    },
    "board_geometry_confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Board Geometry Confidence",
      "type": "number"
    },
    "board_geometry_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Board Geometry Reasons",
      "type": "array"
    },
    "regions": {
      "additionalProperties": {
        "maxItems": 4,
        "minItems": 4,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Regions",
      "type": "object"
    },
    "seat_observations": {
      "items": {
        "$ref": "#/$defs/SeatOccupancyObservation"
      },
      "title": "Seat Observations",
      "type": "array"
    }
  },
  "required": [
    "captured_at",
    "frame_sequence",
    "content_sha256",
    "layout_id",
    "table_size",
    "frame_width",
    "frame_height",
    "target_fingerprint",
    "capture_latency_ms",
    "ocr_latency_ms",
    "visual_role_confidence",
    "current_hand_supported",
    "current_hand_mode",
    "standard_nlh_supported",
    "single_board_bomb_pot_supported",
    "bomb_pot_state",
    "rule_confidence",
    "mode_reason",
    "rule_text",
    "pot_text",
    "board_rows",
    "board_card_slots",
    "board_geometry_supported",
    "board_geometry_confidence",
    "regions"
  ],
  "title": "LiveCaptureDiagnostic",
  "type": "object"
}
