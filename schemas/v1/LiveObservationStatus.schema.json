  "required": [
    "running",
    "table_size",
    "interval_ms",
    "latest_sequence",
    "frames_attempted",
    "frames_succeeded",
    "frames_failed",
    "consecutive_failures",
    "target_stable",
    "current_hand_mode",
    "current_hand_supported",
    "mode_consensus"
