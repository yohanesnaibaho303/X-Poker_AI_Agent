      "title": "Interval Ms",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "stopped_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stopped At"
    },
    "latest_sequence": {
      "minimum": 0,
      "title": "Latest Sequence",
      "type": "integer"
    },
    "frames_attempted": {
      "minimum": 0,
      "title": "Frames Attempted",
      "type": "integer"
    },
    "frames_succeeded": {
      "minimum": 0,
      "title": "Frames Succeeded",
      "type": "integer"
    },
    "frames_failed": {
      "minimum": 0,
      "title": "Frames Failed",
      "type": "integer"
    },
    "consecutive_failures": {
      "minimum": 0,
      "title": "Consecutive Failures",
      "type": "integer"
    },
    "latest_captured_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Captured At"
    },
    "latest_age_ms": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Age Ms"
    },
    "target_fingerprint": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Fingerprint"
