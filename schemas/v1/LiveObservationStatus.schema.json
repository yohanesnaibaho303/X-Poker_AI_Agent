{
  "$defs": {
    "TemporalConsensus": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "stable_frames": {
          "minimum": 0,
          "title": "Stable Frames",
          "type": "integer"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "accepted",
        "confidence",
        "stable_frames"
      ],
      "title": "TemporalConsensus",
      "type": "object"
    }
  },
  "additionalProperties": false,
