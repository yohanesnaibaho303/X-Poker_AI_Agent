    "current_hand_supported": {
      "title": "Current Hand Supported",
      "type": "boolean"
    },
    "mode_consensus": {
      "$ref": "#/$defs/TemporalConsensus"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
